{
  "name": "portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Vatsal Jain's personal site: a calm, static Astro portfolio.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-links.mjs",
    "setup:wasm": "node scripts/setup-wasm-compiler.mjs",
    "verify": "npm run check && npm run format:check && npm run build && npm run check:links"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/eb-garamond": "^5.3.0",
    "astro": "^7.4.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.166.0"
  }
}
