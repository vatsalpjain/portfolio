---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<p class="now">
  <span class="dot" aria-hidden="true"></span>
  {text}
</p>

<style>
  .now {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-small);
    color: var(--c-sage-deep);
    background: var(--c-sage-tint);
    border-radius: var(--r-full);
    padding: 4px 14px 4px 12px;
    margin: 0 0 var(--s-5);
    line-height: 1.4;
  }
  .dot {
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-sage);
  }
  .dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c-sage);
    animation: breathe 2.4s var(--ease) infinite;
  }
  @keyframes breathe {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot::after {
      animation: none;
    }
  }
</style>
