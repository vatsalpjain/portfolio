---
import type { CollectionEntry } from "astro:content";
import { formatShortDate, isoDate } from "../lib/format";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props;
---

<ul class="posts">
  {posts.map((post) => (
    <li>
      <time class="date" datetime={isoDate(post.data.date)}>
        {formatShortDate(post.data.date)}
      </time>
      <div>
        <a class="title" href={`/blog/${post.id}/`}>
          {post.data.title}{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        <span class="desc">{post.data.summary}</span>
      </div>
    </li>
  ))}
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: var(--s-4);
    padding: 14px 10px;
    margin: 0 -10px;
    border-radius: var(--r-sm);
    transition: background var(--dur-base) var(--ease);
  }
  li:hover {
    background: var(--c-sage-tint);
  }
  .date {
    color: var(--c-muted);
    font-size: var(--fs-small);
    padding-top: 2px;
    font-variant-numeric: lining-nums tabular-nums;
    transition: color var(--dur-base) var(--ease);
  }
  li:hover .date {
    color: var(--c-sage-deep);
  }
  .title {
    color: var(--c-ink);
    text-decoration: none;
    font-weight: var(--fw-medium);
    background: none;
  }
  .title:hover {
    color: var(--c-sage-deep);
  }
  .arrow {
    display: inline-block;
    color: var(--c-sage);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }
  li:hover .arrow {
    opacity: 1;
    transform: none;
  }
  .desc {
    display: block;
    font-size: var(--fs-small);
    color: var(--c-muted);
    line-height: 1.5;
    margin-top: 2px;
  }
  @media (max-width: 760px) {
    li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
