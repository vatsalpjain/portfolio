---
// Projects: every public repo tagged "portfolio", newest activity first (decision 0003).
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import EmptyState from "../components/EmptyState.astro";
import { site } from "../site.config";

const projects = (await getCollection("projects"))
  .map((p) => p.data)
  .sort((a, b) => b.pushedAt.getTime() - a.pushedAt.getTime());
---

<BaseLayout
  title="Projects"
  description="Things Vatsal Jain has built, pulled straight from GitHub."
>
  <h1 class="page-title">Projects</h1>
  <p class="lede measure">
    Things I've built, pulled straight from{" "}
    <a href={site.links.github}>my GitHub</a>. Open a row for a short summary
    and links.
  </p>

  {projects.length > 0 ? (
    <div class="list">
      {projects.map((p) => (
        <ProjectRow project={p} />
      ))}
    </div>
  ) : (
    <EmptyState title="No projects listed yet.">
      <p>They'll appear here as I tag them on GitHub.</p>
    </EmptyState>
  )}
</BaseLayout>

<style>
  .list {
    border-top: 1px solid var(--c-border);
  }
</style>
