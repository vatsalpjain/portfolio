---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/posts";
import { formatDate, isoDate, readingTime } from "../../lib/format";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // posts are newest first: "previous" = older, "next" = newer
      prev: posts[i + 1],
      next: posts[i - 1],
    },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  type="article"
>
  <article>
    <h1 class="page-title">{post.data.title}</h1>
    <p class="meta">
      <time datetime={isoDate(post.data.date)}>
        {formatDate(post.data.date)}
      </time>
      · {readingTime(post.body)}
      {post.data.draft && <strong class="draft"> · Draft</strong>}
    </p>

    <div class="prose measure post">
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {post.data.tags.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )}
  </article>

  {(prev || next) && (
    <nav class="pager" aria-label="More posts">
      {prev ? (
        <a href={`/blog/${prev.id}/`}>
          <span class="lbl">Previous</span>
          {prev.data.title}
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={`/blog/${next.id}/`} class="right">
          <span class="lbl">Next</span>
          {next.data.title}
        </a>
      )}
    </nav>
  )}
</BaseLayout>

<style>
  .meta {
    color: var(--c-muted);
    font-size: var(--fs-small);
    font-style: italic;
    margin-bottom: var(--s-6);
  }
  .draft {
    color: #8a5a3c;
  }
  /* Sage drop cap on the first paragraph of a post. */
  .post > :global(p:first-of-type)::first-letter {
    float: left;
    font-size: 3.4em;
    line-height: 0.8;
    padding: 8px 10px 0 0;
    color: var(--c-sage);
    font-weight: var(--fw-medium);
  }
  .tags {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
  }
  .tag {
    font-size: var(--fs-tiny);
    color: var(--c-sage-deep);
    background: var(--c-sage-tint);
    border-radius: var(--r-sm);
    padding: 2px 10px;
  }
  .tag::before {
    content: "#";
    color: var(--c-sage-mid);
    margin-right: 1px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    border-top: 1px solid var(--c-border);
    padding-top: var(--s-4);
    margin-top: var(--s-8);
    font-size: var(--fs-small);
  }
  .pager a {
    text-decoration: none;
  }
  .pager .right {
    text-align: right;
  }
  .lbl {
    display: block;
    color: var(--c-muted);
    font-size: var(--fs-tiny);
    font-style: italic;
  }
  @media (max-width: 760px) {
    .post > :global(p:first-of-type)::first-letter {
      font-size: 2.6em;
    }
  }
</style>
