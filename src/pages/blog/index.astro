---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Writing by Vatsal Jain.">
  <h1 class="page-title">Blog</h1>
  <p class="lede measure">Notes on what I'm building and learning.</p>

  {posts.length > 0 ? (
    <PostList posts={posts} />
  ) : (
    <EmptyState title="Nothing written yet.">
      <p>The first post will come when there's something worth saying.</p>
    </EmptyState>
  )}
</BaseLayout>
